<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cadastro de Veículo" android:textSize="25sp" android:textStyle="bold" />
    <EditText android:id="@+id/edtMarca" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:hint="Marca" />
    <EditText android:id="@+id/edtModelo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Modelo" />
    <EditText android:id="@+id/edtValor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Valor" android:inputType="numberDecimal" />
    <Button android:id="@+id/btnSalvarVeiculo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Salvar veículo" />
    <TextView android:id="@+id/txtVeiculos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Nenhum veículo cadastrado." android:textSize="16sp" />
</LinearLayout>
</ScrollView>
